{
    "name": "website-chleih",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "description": "Personal portfolio website",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "prepare": "husky",
        "format": "prettier . --write",
        "format:check": "prettier . --check",
        "lint": "npm run lint:js && npm run lint:scss",
        "lint:fix": "npm run lint:js:fix && npm run lint:scss:fix",
        "lint:js": "eslint src/js scripts eslint.config.js vite.config.js",
        "lint:js:fix": "eslint src/js scripts eslint.config.js vite.config.js --fix",
        "lint:scss": "stylelint \"src/scss/**/*.scss\"",
        "lint:scss:fix": "stylelint \"src/scss/**/*.scss\" --fix",
        "quality": "npm run lint && npm run check:html && npm run check:pages && npm run check:unused",
        "quality:fix": "npm run lint:fix && npm run format",
        "check:js": "node scripts/check-js-syntax.js",
        "check:sass": "node scripts/check-sass.js",
        "check:pages": "node scripts/check-page-architecture.js",
        "check:compile": "npm run check:js && npm run check:sass",
        "check:html": "html-validate --config .htmlvalidate.json \"*.html\" && html-validate --config .htmlvalidate.fragments.json \"src/html/**/*.html\"",
        "check:audit": "npm audit --audit-level=moderate",
        "check:unused": "knip",
        "check:dependencies": "npm run check:audit && npm run check:unused",
        "precommit": "lint-staged",
        "test": "node -e \"console.log('No automated tests configured yet.');\"",
        "validate": "npm run format:check && npm run check:compile && npm run quality && npm run check:audit && npm run test"
    },
    "lint-staged": {
        "*.{html,js,json,jsonc,md,scss,yml,yaml}": "prettier --check",
        "*.js": "eslint",
        "*.scss": "stylelint"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "eslint": "^10.4.0",
        "html-validate": "^10.15.0",
        "husky": "^9.1.7",
        "knip": "^6.12.2",
        "lint-staged": "^17.0.5",
        "prettier": "3.8.3",
        "sass": "^1.98.0",
        "stylelint": "^17.11.1",
        "stylelint-config-standard-scss": "^17.0.0",
        "vite": "^8.0.13"
    },
    "dependencies": {
        "bootstrap-icons": "^1.13.1"
    }
}
