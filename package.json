{
    "name": "website-chleih",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "description": "Personal portfolio website",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "format": "prettier . --write",
        "format:check": "prettier . --check",
        "lint": "npm run lint:js",
        "lint:fix": "npm run lint:js:fix",
        "lint:js": "eslint src/js scripts eslint.config.js vite.config.js",
        "lint:js:fix": "eslint src/js scripts eslint.config.js vite.config.js --fix",
        "check:js": "node scripts/check-js-syntax.js",
        "check:sass": "node scripts/check-sass.js",
        "check:dependencies": "npm audit --audit-level=moderate",
        "validate": "npm run format:check && npm run lint && npm run check:js && npm run check:sass"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "eslint": "^10.3.0",
        "eslint-config-prettier": "^9.0.0",
        "eslint-plugin-prettier": "^5.5.5",
        "html-validate": "^10.15.0",
        "knip": "^6.12.0",
        "prettier": "3.8.3",
        "sass": "^1.98.0",
        "stylelint": "^17.11.0",
        "stylelint-config-standard-scss": "^17.0.0",
        "vite": "^8.0.10"
    }
}
