# ignore temporary backup files
*~

# ignore node/grunt dependency directories
node_modules/
/node_modules/

# ignore OS generated files
.DS_Store
ehthumbs.db
Thumbs.db

# ignore log files
*.log
.npm-cache/
coverage/
.commandtree/

# ignore local environment overrides
.env.local
.env.*.local

# VS Code
.vsconfig
.vs/
.vscode/*

# ignore distribution folder created when building
dist/

# --------------------------------------------------------
# BEGIN Explictly Allowed Files (i.e. do NOT ignore these)
# --------------------------------------------------------

# track these files, if they exist
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/tasks.json
