# Top-most EditorConfig file
root = true

# Unix-style newlines with a newline ending every file
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Prettier-managed source and config files
[*.{html,css,scss,js,json,jsonc,md}]
indent_style = space
indent_size = 4

# YAML convention
[*.{yml,yaml}]
indent_style = space
indent_size = 2

# Whitespace override for markdown prose
[*.md]
trim_trailing_whitespace = false
