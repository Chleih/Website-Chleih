{
    // -------------------- FORMATTING --------------------
    "editor.formatOnSave": true,
    "editor.formatOnPaste": false,
    "editor.detectIndentation": false,
    "editor.defaultFormatter": "esbenp.prettier-vscode",

    // -------------------- PRETTIER --------------------
    "prettier.useEditorConfig": true,

    // -------------------- LINTING --------------------
    "eslint.validate": ["javascript"],

    // -------------------- FILE VISIBILITY --------------------
    "files.exclude": {
        "**/node_modules": true,
        "**/.DS_Store": true
    },

    // -------------------- LANGUAGE OVERRIDES --------------------
    "[yaml]": {
        "editor.formatOnSave": true
    }
}
